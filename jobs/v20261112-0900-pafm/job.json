ara","ropa":"azul","edad":25},{"k":"icono","en":"cableado","f":"linea","x":200,"y":400,"x2":520,"y2":400,"c":"naranja","dur":0.5,"texto":"forma"},{"k":"icono","en":"intacto","nombre":"check","x":560,"y":330,"esc":0.8}],"camara":[{"en":"cableado","zoom":1,"foco":[360,400],"dur":0.8}],"key":"cableado","see":"en 'hoy', persona actual en su sala con auriculares; en 'cableado', esquema simplificado de vía dopaminérgica a sistema simpático brillando"}},{"texto":"Por eso la piel se eriza con la música, no con el frío.","plantilla":"guion","p":{"piezas":[{"k":"icono","en":"piel","f":"circ","x":360,"y":500,"r":80,"c":"piel","mov":[360,500],"dur":0.1,"texto":"forma"},{"k":"icono","en":"eriza","f":"linea","x":360,"y":480,"x2":360,"y2":420,"c":"blanco","dur":0.4,"texto":"forma"},{"k":"icono","en":"frío","nombre":"nieve","x":580,"y":380,"esc":0.6,"anim":"flota"}],"camara":[{"en":"frío","zoom":2,"foco":[360,500],"dur":0.7}],"key":"frío","see":"en 'piel', macro del antebrazo con vellos erguidos; en 'frío', copo de nieve se desvanece al lado, contraste visual"}},{"texto":"Envíaselo a quien se le eriza la piel con su canción favorita.","plantilla":"guion","p":{"piezas":[{"k":"persona","en":"envíaselo","pose":"señala","y":540,"pelo":"marron","piel":"media","ropa":"verde","edad":28},{"k":"icono","en":"canción","nombre":"nota","x":580,"y":380,"esc":0.7,"anim":"late"},{"k":"icono","en":"favorita","f":"circ","x":360,"y":400,"r":40,"c":"lima","mov":[360,400],"dur":0.6,"texto":"forma"}],"camara":[{"en":"favorita","zoom":1.1,"foco":[360,450],"dur":0.8}],"key":"favorita","see":"en 'envíaselo', persona mira a cámara y señala al espectador; en 'favorita', aro lima pulsa al ritmo en el centro, vuelta a la imagen del inicio"}}]}